{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-6",
  "share": "disabled",
  "autoupdate": false,
  "agent": {
    "ai-reviewer": {
      "mode": "primary",
      "description": "Read-only PR reviewer: can read/grep/glob the checkout, nothing else.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "task": "deny",
        "skill": "deny",
        "external_directory": "deny"
      }
    }
  }
}
