{
  "bot_can_approve": true,
  "max_diff_bytes": 400000,
  "sensitive_paths": [
    "auth/",
    "payments/",
    "secrets/",
    ".github/workflows/",
    "review-config.json",
    "*.pem",
    "*.key"
  ],
  "thresholds": {
    "trivial": {
      "max_lines": 10,
      "max_files": 2
    },
    "lite": {
      "max_lines": 100,
      "max_files": 10
    }
  },
  "scanners": {
    "fail_on_error": false,
    "gitleaks": {
      "enabled": true,
      "block_on": "low"
    },
    "osv": {
      "enabled": true,
      "block_on": "high"
    },
    "opengrep": {
      "enabled": true,
      "block_on": "none"
    },
    "trivy": {
      "enabled": true,
      "block_on": "critical"
    },
    "zizmor": {
      "enabled": true,
      "block_on": "high",
      "ignore_rules": []
    },
    "actionlint": {
      "enabled": true,
      "block_on": "none"
    }
  }
}
